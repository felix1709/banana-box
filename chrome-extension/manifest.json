{
  "manifest_version": 3,
  "name": "banana-box",
  "version": "0.1.0",
  "icons": {
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["contextMenus", "activeTab", "scripting", "notifications", "storage", "unlimitedStorage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  }
}
